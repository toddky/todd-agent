#!/usr/bin/env bash
# Tool contract: JSON args on stdin, result text on stdout, reason on stderr.
# "--schema" prints the tool's self-description so the registry can discover it.
# Exit codes:
#   0 = success
#   1 = runtime failure
#   2 = malformed call (bad arguments)

# ==============================================================================
# SCHEMA
# ==============================================================================
if [[ "${1:-}" == "--schema" ]]; then
	cat <<'SCHEMA'
{
  "description": "Find files by glob pattern, e.g. '*.go' or '**/*_test.go'. Input: {\"pattern\": \"<glob>\", \"path\": \"<search dir>\", \"depth\": <max levels>}; path defaults to the current directory, depth is unlimited when omitted. Uses ripgrep when available (skips hidden files but does not respect .gitignore); falls back to find (sees everything). A slow walk is cut off early and reports partial results. Output is capped at 200 paths.",
  "input_schema": {
    "type": "object",
    "properties": {
      "pattern": {"type": "string", "description": "Glob pattern to match file names or paths"},
      "path": {"type": "string", "description": "Directory to search; defaults to the current directory"},
      "depth": {"type": "integer", "description": "Max directory levels to descend; unlimited when omitted"}
    },
    "required": ["pattern"]
  },
  "timeout_secs": 10
}
SCHEMA
	exit 0
fi


# ==============================================================================
# PARSE
# ==============================================================================
input_json="$(cat)"
if ! pattern="$(jq -r '.pattern // ""' <<< "$input_json" 2>&1)"; then
	echo "glob: input is not valid JSON: $pattern" 1>&2
	exit 2
fi
search_dir="$(jq -r '.path // "."' <<< "$input_json")"
depth="$(jq -r '.depth // "" | tostring' <<< "$input_json")"
if [[ -z "$pattern" ]]; then
	echo "glob: missing required \"pattern\" in JSON input; expected {\"pattern\": \"<glob>\"}" 1>&2
	exit 2
fi
if [[ -n "$depth" && ! "$depth" =~ ^[0-9]+$ ]]; then
	echo "glob: \"depth\" must be a non-negative integer; got: $depth" 1>&2
	exit 2
fi
# Self-time to the caller's timeout_secs, falling back to our schema default.
# The agent's hard kill is this value plus a grace, so timing out here yields partial results first.
walk_timeout="$(jq -r '.timeout_secs // empty' <<< "$input_json")"
if [[ -z "$walk_timeout" ]]; then
	walk_timeout="$("$0" --schema | jq -r '.timeout_secs')"
fi


# ==============================================================================
# MAIN
# ==============================================================================
# Expand ~ and $VARs like read_file does; the path never reaches a shell reparse.
expanded_dir="$search_dir"
if command -v python3 > /dev/null 2>&1; then
	expanded_dir="$(printf '%s' "$search_dir" | python3 -c 'import os, sys; print(os.path.expandvars(os.path.expanduser(sys.stdin.read())))')"
else
	echo "glob: warning: python3 is not installed; using the path without expanding ~ and \$VARs" 1>&2
fi

if [[ ! -d "$expanded_dir" ]]; then
	echo "glob: not a directory: $search_dir" 1>&2
	exit 1
fi

# 200 paths is plenty for a model to scan; more usually means the pattern needs narrowing.
max_results=200

walk_cmd=()
if command -v rg > /dev/null 2>&1; then
	# rg is the fast walker; --no-ignore stops it honoring .gitignore so it sees the same files as
	# the find fallback. It still skips hidden files (including .git) by default.
	walk_cmd=(rg --files --no-ignore --glob "$pattern")
	if [[ -n "$depth" ]]; then
		walk_cmd+=(--max-depth "$depth")
	fi
	walk_cmd+=(-- "$expanded_dir")
else
	# Fallback walker sees everything, including .git and ignored files, unlike the rg tier.
	walk_cmd=(find "$expanded_dir")
	if [[ -n "$depth" ]]; then
		walk_cmd+=(-maxdepth "$depth")
	fi
	# A slash pattern targets a path, so use -path to mirror rg's relative-path glob; -name sees only the basename.
	# find's * spans '/' while rg's does not, so the dialects still differ on '**'; exact parity is impossible.
	if [[ "$pattern" == */* ]]; then
		walk_cmd+=(-path "*/$pattern" -print)
	else
		walk_cmd+=(-name "$pattern" -print)
	fi
fi

# A budget under 1s leaves no useful walk time, so run unwrapped and let the agent's deadline rule.
if (( walk_timeout >= 1 )); then
	walk_cmd=(timeout "$walk_timeout" "${walk_cmd[@]}")
fi
matches="$("${walk_cmd[@]}" 2>/dev/null)"
walk_status=$?

# timeout(1) exits 124 when it had to kill the walker; whatever was printed so far is still usable.
timed_out=""
if (( walk_status == 124 )); then
	timed_out="yes"
fi


# ==============================================================================
# RESULTS
# ==============================================================================
if [[ -z "$matches" ]]; then
	if [[ -n "$timed_out" ]]; then
		echo "glob: walk timed out after ${walk_timeout}s with no matches; narrow the path or add a depth limit" 1>&2
	else
		echo "glob: no files match: $pattern" 1>&2
	fi
	exit 1
fi

total_count="$(wc -l <<< "$matches")"
head -n "$max_results" <<< "$matches"
if (( total_count > max_results )); then
	echo "... truncated: showing $max_results of $total_count matches; narrow the pattern or path"
fi
if [[ -n "$timed_out" ]]; then
	echo "... walk timed out after ${walk_timeout}s: results are partial; narrow the path or add a depth limit"
fi

#!/usr/bin/env ruby
# Tool contract: JSON args on stdin, result text on stdout, reason on stderr.
# "--schema" prints the tool's self-description so the registry can discover it.
# Exit codes:
#   0 = success
#   1 = runtime failure
#   2 = malformed call (bad arguments)

require 'json'
require_relative 'gitlab'

# ==============================================================================
# SCHEMA
# ==============================================================================
if ARGV[0] == '--schema'
	schema = {
		'description' => 'Show the GitLab account that owns the current API token: id, username, name, email, and admin flag. Takes no input; pass {} or nothing.',
		'input_schema' => {
			'type' => 'object',
			'properties' => {}
		},
		'timeout_secs' => 30
	}
	puts JSON.pretty_generate(schema)
	exit 0
end

# ==============================================================================
# REQUEST
# ==============================================================================
begin
	token = get_gitlab_token()
rescue StandardError => e
	warn "gitlab_whoami: #{e.message}"
	exit 1
end

begin
	response = gitlab_request('GET', 'user', token)
rescue StandardError => e
	warn "gitlab_whoami: request failed: #{e.message}"
	exit 1
end

unless response.is_a?(Net::HTTPSuccess)
	warn "gitlab_whoami: GitLab returned HTTP #{response.code}: #{response.body}"
	exit 1
end

begin
	me = JSON.parse(response.body)
rescue JSON::ParserError => e
	warn "gitlab_whoami: response is not valid JSON: #{e.message}"
	exit 1
end

# ==============================================================================
# RESULTS
# ==============================================================================
lines = []
lines.append("ID: #{me['id']}")
lines.append("Username: #{me['username']}")
lines.append("Name: #{me['name']}")
lines.append("Email: #{me['email']}")
lines.append("Admin: #{me['is_admin'] ? 'yes' : 'no'}")

puts lines.join("\n")

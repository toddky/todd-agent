#!/usr/bin/env ruby
# Tool contract: JSON args on stdin, result text on stdout, reason on stderr.
# "--schema" prints the tool's self-description so the registry can discover it.
# Exit codes:
#   0 = success
#   1 = runtime failure
#   2 = malformed call (bad arguments)

require 'json'
require_relative 'gitlab'

# ==============================================================================
# SCHEMA
# ==============================================================================
if ARGV[0] == '--schema'
	schema = {
		'description' => 'Post a comment (note) on a GitLab merge request. A "Generated by LLM-Agent" footer is appended automatically. Input: {"project": "<id or path>", "iid": <mr iid>, "body": "<comment>"}. project may be a numeric id (505) or a path (riscv/riscv_cluster).',
		'input_schema' => {
			'type' => 'object',
			'properties' => {
				'project' => { 'type' => 'string', 'description' => 'Project numeric id (e.g. "505") or path (e.g. "riscv/riscv_cluster")' },
				'iid' => { 'type' => 'integer', 'description' => 'Merge request iid (the !NNN number)' },
				'body' => { 'type' => 'string', 'description' => 'Comment body (Markdown). Do not add your own footer; one is appended automatically.' }
			},
			'required' => ['project', 'iid', 'body']
		},
		'timeout_secs' => 30
	}
	puts JSON.pretty_generate(schema)
	exit 0
end

# ==============================================================================
# PARSE
# ==============================================================================
input_json = $stdin.read
begin
	args = JSON.parse(input_json)
rescue JSON::ParserError => e
	warn "gitlab_comment_mr: input is not valid JSON: #{e.message}"
	exit 2
end

project = args['project']
if !project.is_a?(String) || project.empty?
	warn 'gitlab_comment_mr: missing required non-empty string "project" in JSON input'
	exit 2
end

iid = args['iid']
unless iid.is_a?(Integer)
	warn 'gitlab_comment_mr: missing required integer "iid" in JSON input'
	exit 2
end

comment = args['body']
if !comment.is_a?(String) || comment.empty?
	warn 'gitlab_comment_mr: missing required non-empty string "body" in JSON input'
	exit 2
end

# ==============================================================================
# REQUEST
# ==============================================================================
begin
	token = get_gitlab_token()
rescue StandardError => e
	warn "gitlab_comment_mr: #{e.message}"
	exit 1
end

endpoint = "projects/#{gitlab_project(project)}/merge_requests/#{iid}/notes"
begin
	response = gitlab_request('POST', endpoint, token, { 'body' => comment + GITLAB_GENERATED_FOOTER })
rescue StandardError => e
	warn "gitlab_comment_mr: request failed: #{e.message}"
	exit 1
end

unless response.is_a?(Net::HTTPSuccess)
	warn "gitlab_comment_mr: GitLab returned HTTP #{response.code} for !#{iid}: #{response.body}"
	exit 1
end

# ==============================================================================
# RESULTS
# ==============================================================================
note = JSON.parse(response.body)
puts "Posted comment ##{note['id']} on !#{iid}"

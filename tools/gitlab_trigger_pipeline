#!/usr/bin/env ruby
# Tool contract: JSON args on stdin, result text on stdout, reason on stderr.
# "--schema" prints the tool's self-description so the registry can discover it.
# Exit codes:
#   0 = success
#   1 = runtime failure
#   2 = malformed call (bad arguments)

require 'json'
require_relative 'gitlab'

# ==============================================================================
# SCHEMA
# ==============================================================================
if ARGV[0] == '--schema'
	schema = {
		'description' => 'Run a new GitLab pipeline on a ref. Input: {"project": "<id or path>", "ref": "<branch or tag>"}. project may be a numeric id (505) or a path (riscv/riscv_cluster). Note: for an MR targeting a non-main branch, a source-branch pipeline may fail instantly with zero jobs; a push to the TARGET branch is the reliable trigger in that case.',
		'input_schema' => {
			'type' => 'object',
			'properties' => {
				'project' => { 'type' => 'string', 'description' => 'Project numeric id (e.g. "505") or path (e.g. "riscv/riscv_cluster")' },
				'ref' => { 'type' => 'string', 'description' => 'Branch or tag to run the pipeline on, e.g. "babylon/main"' }
			},
			'required' => ['project', 'ref']
		},
		'timeout_secs' => 30
	}
	puts JSON.pretty_generate(schema)
	exit 0
end

# ==============================================================================
# PARSE
# ==============================================================================
input_json = $stdin.read
begin
	args = JSON.parse(input_json)
rescue JSON::ParserError => e
	warn "gitlab_trigger_pipeline: input is not valid JSON: #{e.message}"
	exit 2
end

%w[project ref].each do |field|
	value = args[field]
	next if value.is_a?(String) && !value.empty?
	warn "gitlab_trigger_pipeline: missing required non-empty string \"#{field}\" in JSON input"
	exit 2
end

# ==============================================================================
# REQUEST
# ==============================================================================
begin
	token = get_gitlab_token()
rescue StandardError => e
	warn "gitlab_trigger_pipeline: #{e.message}"
	exit 1
end

endpoint = "projects/#{gitlab_project(args['project'])}/pipeline"
begin
	response = gitlab_request('POST', endpoint, token, { 'ref' => args['ref'] })
rescue StandardError => e
	warn "gitlab_trigger_pipeline: request failed: #{e.message}"
	exit 1
end

unless response.is_a?(Net::HTTPSuccess)
	warn "gitlab_trigger_pipeline: GitLab returned HTTP #{response.code}: #{response.body}"
	exit 1
end

# ==============================================================================
# RESULTS
# ==============================================================================
pipeline = JSON.parse(response.body)
puts "Started pipeline ##{pipeline['id']} on #{pipeline['ref']} (status: #{pipeline['status']}): #{pipeline['web_url']}"

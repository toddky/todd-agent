#!/usr/bin/env python3
# Tool contract: JSON args on stdin, result text on stdout, reason on stderr.
# "--schema" prints the tool's self-description so the registry can discover it.
# Exit codes:
#   0 = success
#   1 = runtime failure
#   2 = malformed call (bad arguments)
import json
import os
import sys
import tempfile

# ==============================================================================
# VERSION
# ==============================================================================
# f-strings (used throughout) require 3.6; nothing here needs anything newer.
if sys.version_info < (3, 6):
    sys.stderr.write("edit_file: requires Python 3.6 or newer\n")
    sys.exit(1)

# ==============================================================================
# SCHEMA
# ==============================================================================
SCHEMA = {
    "description": (
        'Edit a file with exact string replacements. '
        'Input: {"path": "<file>", "edits": [{"old_text": "<exact text>", "new_text": "<replacement>"}]}. '
        "Each old_text must match exactly one location in the file; edits apply in order. "
        "Include enough surrounding lines in old_text to make the match unique."
    ),
    "input_schema": {
        "type": "object",
        "properties": {
            "path": {"type": "string", "description": "Path of the file to edit"},
            "edits": {
                "type": "array",
                "description": "Replacements applied in order",
                "items": {
                    "type": "object",
                    "properties": {
                        "old_text": {"type": "string", "description": "Exact text to replace; must match exactly once"},
                        "new_text": {"type": "string", "description": "Replacement text"},
                    },
                    "required": ["old_text", "new_text"],
                },
                "minItems": 1,
            },
        },
        "required": ["path", "edits"],
    },
}

if len(sys.argv) > 1 and sys.argv[1] == "--schema":
    print(json.dumps(SCHEMA, indent=2))
    sys.exit(0)


# ==============================================================================
# PARSE
# ==============================================================================
def malformed(reason):
    print(f"edit_file: {reason}", file=sys.stderr)
    sys.exit(2)


def failed(reason):
    print(f"edit_file: {reason}", file=sys.stderr)
    sys.exit(1)


try:
    call = json.load(sys.stdin)
except json.JSONDecodeError as decode_error:
    malformed(f"input is not valid JSON: {decode_error}")

input_path = call.get("path")
edits = call.get("edits")
if not isinstance(input_path, str) or not input_path:
    malformed('missing required "path" in JSON input; expected {"path": "<file>", "edits": [...]}')
if not isinstance(edits, list) or not edits:
    malformed('missing required "edits" in JSON input; expected a non-empty array of {"old_text", "new_text"}')
for position, edit in enumerate(edits):
    if not isinstance(edit, dict) or not isinstance(edit.get("old_text"), str) or not isinstance(edit.get("new_text"), str):
        malformed(f'edits[{position}] must be an object with string "old_text" and "new_text"')
    if edit["old_text"] == "":
        malformed(f'edits[{position}].old_text must not be empty')
    if edit["old_text"] == edit["new_text"]:
        malformed(f'edits[{position}].old_text and new_text are identical; this edit would change nothing')


# ==============================================================================
# MAIN
# ==============================================================================
# Error messages echo the original path, never the expanded one, so secret env values cannot leak into output.
expanded_path = os.path.expandvars(os.path.expanduser(input_path))
if not os.path.isfile(expanded_path):
    failed(f"file not found: {input_path}")

try:
    with open(expanded_path, encoding="utf-8") as edited_file:
        content = edited_file.read()
except (OSError, UnicodeDecodeError) as read_error:
    failed(f"cannot read {input_path}: {read_error}")

# Validate each edit against the content as it evolves, so ordered edits may build on earlier ones.
for position, edit in enumerate(edits):
    occurrences = content.count(edit["old_text"])
    if occurrences == 0:
        failed(f"edits[{position}].old_text not found in {input_path}; re-read the file and copy the text exactly")
    if occurrences > 1:
        failed(f"edits[{position}].old_text matches {occurrences} locations in {input_path}; add surrounding lines to make it unique")
    content = content.replace(edit["old_text"], edit["new_text"], 1)


# ==============================================================================
# RESULTS
# ==============================================================================
# Write to a temp file in the same directory then atomically replace, so a crash mid-write
# leaves the original intact instead of a truncated file. Same-dir keeps the replace on one filesystem.
original_mode = os.stat(expanded_path).st_mode
target_dir = os.path.dirname(expanded_path) or "."
try:
    temp_fd, temp_file = tempfile.mkstemp(dir=target_dir, prefix=".edit_file.")
    try:
        with os.fdopen(temp_fd, "w", encoding="utf-8") as edited_file:
            edited_file.write(content)
        os.chmod(temp_file, original_mode)
        os.replace(temp_file, expanded_path)
    except OSError:
        os.unlink(temp_file)
        raise
except OSError as write_error:
    failed(f"cannot write {input_path}: {write_error}")

print(f"edited {input_path}: {len(edits)} replacement(s)")

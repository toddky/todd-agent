#!/usr/bin/env ruby
# Tool contract: JSON args on stdin, result text on stdout, reason on stderr.
# "--schema" prints the tool's self-description so the registry can discover it.
# Exit codes:
#   0 = success
#   1 = runtime failure
#   2 = malformed call (bad arguments)

require 'json'
require_relative 'glean'

# ==============================================================================
# SCHEMA
# ==============================================================================
if ARGV[0] == '--schema'
	schema = {
		'description' => 'Send a message to Glean Assistant chat and return its reply. Input: {"message": "<question>", "context": ["<optional prior message>", ...]}.',
		'input_schema' => {
			'type' => 'object',
			'properties' => {
				'message' => { 'type' => 'string', 'description' => 'The question or message to send to Glean Assistant' },
				'context' => {
					'type' => 'array',
					'items' => { 'type' => 'string' },
					'description' => 'Optional prior messages, included in order before the current message'
				}
			},
			'required' => ['message']
		},
		'timeout_secs' => 60
	}
	puts JSON.pretty_generate(schema)
	exit 0
end

# ==============================================================================
# PARSE
# ==============================================================================
input_json = $stdin.read
begin
	args = JSON.parse(input_json)
rescue JSON::ParserError => e
	warn "glean_search: input is not valid JSON: #{e.message}"
	exit 2
end

message = args['message']
if !message.is_a?(String) || message.empty?
	warn 'glean_search: missing required non-empty string "message" in JSON input; expected {"message": "...", "context": [...]}'
	exit 2
end

context = args.fetch('context', [])
unless context.is_a?(Array) && context.all? { |item| item.is_a?(String) }
	warn 'glean_search: "context" must be an array of strings if present'
	exit 2
end

# ==============================================================================
# REQUEST
# ==============================================================================
begin
	auth = get_glean_auth
rescue StandardError => e
	warn "glean_search: #{e.message}"
	exit 1
end

messages = context.map { |text| { 'author' => 'USER', 'fragments' => [{ 'text' => text }] } }
messages << { 'author' => 'USER', 'fragments' => [{ 'text' => message }] }
payload = { 'messages' => messages, 'stream' => false }

begin
	response = glean_post(auth, 'chat', payload)
rescue StandardError => e
	warn "glean_search: request failed: #{e.message}"
	exit 1
end

unless response.is_a?(Net::HTTPSuccess)
	warn "glean_search: Glean API returned #{response.code}: #{response.body}"
	exit 1
end

begin
	result = JSON.parse(response.body)
rescue JSON::ParserError => e
	warn "glean_search: could not parse Glean response as JSON: #{e.message}"
	exit 1
end

# ==============================================================================
# RESULTS
# ==============================================================================
reply_messages = result['messages'] || []
assistant_messages = reply_messages.reject { |reply_message| reply_message['author'] == 'USER' }

fragment_texts = []
assistant_messages.each do |reply_message|
	fragments = reply_message['fragments'] || []
	fragments.each do |fragment|
		fragment_texts.append(fragment['text'])
	end
end

reply = fragment_texts.compact.join

if reply.empty?
	warn "glean_search: no reply text in Glean response: #{response.body}"
	exit 1
end

puts reply

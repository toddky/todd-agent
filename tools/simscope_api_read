#!/usr/bin/env ruby
# Tool contract: JSON args on stdin, result text on stdout, reason on stderr.
# "--schema" prints the tool's self-description so the registry can discover it.
# Exit codes:
#   0 = success
#   1 = runtime failure
#   2 = malformed call (bad arguments)

require 'json'
require_relative 'simscope'

# ==============================================================================
# SCHEMA
# ==============================================================================
if ARGV[0] == '--schema'
	schema = {
		'description' => 'Raw read-only Simscope REST API GET passthrough. Simscope is a test triage and regression management system at aus-ss:8080. The endpoint is relative to /api/ and may include its own query string. Input: {"endpoint": "<endpoint>"}, e.g. {"endpoint": "r/?runtag=tt-regress&days=7&limit=5"} or {"endpoint": "tests/csv?regr=<id>&limit=10000"}. Run simscope_list_endpoints first to discover endpoint families. Returns the raw response body (pretty-printed when JSON). GET only.',
		'input_schema' => {
			'type' => 'object',
			'properties' => {
				'endpoint' => { 'type' => 'string', 'description' => 'Endpoint relative to /api/, e.g. "r/REGRNAME", "tests/csv?regr=<id>", or "config/whoami". A "+" in a name is percent-encoded automatically.' }
			},
			'required' => ['endpoint']
		},
		'timeout_secs' => 30
	}
	puts JSON.pretty_generate(schema)
	exit 0
end

# ==============================================================================
# PARSE
# ==============================================================================
input_json = $stdin.read
begin
	args = JSON.parse(input_json)
rescue JSON::ParserError => e
	warn "simscope_api_read: input is not valid JSON: #{e.message}"
	exit 2
end

endpoint = args['endpoint']
if !endpoint.is_a?(String) || endpoint.empty?
	warn 'simscope_api_read: missing required non-empty string "endpoint" in JSON input; expected {"endpoint": "r/?runtag=tt-regress"}'
	exit 2
end

# ==============================================================================
# REQUEST
# ==============================================================================
begin
	token = get_simscope_token()
rescue StandardError => e
	warn "simscope_api_read: #{e.message}"
	exit 1
end

begin
	response = simscope_get(endpoint, token)
rescue StandardError => e
	warn "simscope_api_read: request failed: #{e.message}"
	exit 1
end

unless response.is_a?(Net::HTTPSuccess)
	warn "simscope_api_read: Simscope returned HTTP #{response.code} for #{endpoint}: #{response.body}"
	exit 1
end

# ==============================================================================
# RESULTS
# ==============================================================================
# Pretty-print when the body parses as JSON; otherwise pass it through as-is (CSV/TSV endpoints).
body = response.body.to_s
begin
	puts JSON.pretty_generate(JSON.parse(body))
rescue JSON::ParserError
	puts body
end

#!/usr/bin/env ruby
# Tool contract: JSON args on stdin, result text on stdout, reason on stderr.
# "--schema" prints the tool's self-description so the registry can discover it.
# Exit codes:
#   0 = success
#   1 = runtime failure
#   2 = malformed call (bad arguments)

require 'json'
require_relative 'gitlab'

# ==============================================================================
# SCHEMA
# ==============================================================================
if ARGV[0] == '--schema'
	schema = {
		'description' => 'Retry all failed or canceled jobs in a GitLab pipeline in one call. Input: {"project": "<id or path>", "pipeline_id": <id>}. project may be a numeric id (505) or a path (riscv/riscv_cluster).',
		'input_schema' => {
			'type' => 'object',
			'properties' => {
				'project' => { 'type' => 'string', 'description' => 'Project numeric id (e.g. "505") or path (e.g. "riscv/riscv_cluster")' },
				'pipeline_id' => { 'type' => 'integer', 'description' => 'Pipeline id (the numeric id from the pipeline URL)' }
			},
			'required' => ['project', 'pipeline_id']
		},
		'timeout_secs' => 30
	}
	puts JSON.pretty_generate(schema)
	exit 0
end

# ==============================================================================
# PARSE
# ==============================================================================
input_json = $stdin.read
begin
	args = JSON.parse(input_json)
rescue JSON::ParserError => e
	warn "gitlab_retry_pipeline: input is not valid JSON: #{e.message}"
	exit 2
end

project = args['project']
if !project.is_a?(String) || project.empty?
	warn 'gitlab_retry_pipeline: missing required non-empty string "project" in JSON input'
	exit 2
end

pipeline_id = args['pipeline_id']
unless pipeline_id.is_a?(Integer)
	warn 'gitlab_retry_pipeline: missing required integer "pipeline_id" in JSON input'
	exit 2
end

# ==============================================================================
# REQUEST
# ==============================================================================
begin
	token = get_gitlab_token()
rescue StandardError => e
	warn "gitlab_retry_pipeline: #{e.message}"
	exit 1
end

endpoint = "projects/#{gitlab_project(project)}/pipelines/#{pipeline_id}/retry"
begin
	response = gitlab_request('POST', endpoint, token, {})
rescue StandardError => e
	warn "gitlab_retry_pipeline: request failed: #{e.message}"
	exit 1
end

unless response.is_a?(Net::HTTPSuccess)
	warn "gitlab_retry_pipeline: GitLab returned HTTP #{response.code} for pipeline #{pipeline_id}: #{response.body}"
	exit 1
end

# ==============================================================================
# RESULTS
# ==============================================================================
pipeline = JSON.parse(response.body)
puts "Retried pipeline ##{pipeline['id']} (status: #{pipeline['status']}): #{pipeline['web_url']}"

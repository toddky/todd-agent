#!/usr/bin/env ruby
# Tool contract: JSON args on stdin, result text on stdout, reason on stderr.
# "--schema" prints the tool's self-description so the registry can discover it.
# Exit codes:
#   0 = success
#   1 = runtime failure
#   2 = malformed call (bad arguments)

require 'json'
require_relative 'gitlab'

# ==============================================================================
# SCHEMA
# ==============================================================================
if ARGV[0] == '--schema'
	schema = {
		'description' => 'Open a GitLab merge request. Input: {"project": "<id or path>", "source_branch": "<branch>", "target_branch": "<branch>", "title": "<title>", "description": "<body>", "assignee_ids": [<ids>], "remove_source_branch": <bool>}. project may be a numeric id (505) or a path (riscv/riscv_cluster). description, assignee_ids, and remove_source_branch are optional.',
		'input_schema' => {
			'type' => 'object',
			'properties' => {
				'project' => { 'type' => 'string', 'description' => 'Project numeric id (e.g. "505") or path (e.g. "riscv/riscv_cluster")' },
				'source_branch' => { 'type' => 'string', 'description' => 'Branch the MR merges from' },
				'target_branch' => { 'type' => 'string', 'description' => 'Branch the MR merges into, e.g. "main"' },
				'title' => { 'type' => 'string', 'description' => 'MR title' },
				'description' => { 'type' => 'string', 'description' => 'MR description body (optional)' },
				'assignee_ids' => { 'type' => 'array', 'items' => { 'type' => 'integer' }, 'description' => 'User ids to assign (optional); Todd is 157' },
				'remove_source_branch' => { 'type' => 'boolean', 'description' => 'Delete the source branch on merge (optional)' }
			},
			'required' => ['project', 'source_branch', 'target_branch', 'title']
		},
		'timeout_secs' => 30
	}
	puts JSON.pretty_generate(schema)
	exit 0
end

# ==============================================================================
# PARSE
# ==============================================================================
input_json = $stdin.read
begin
	args = JSON.parse(input_json)
rescue JSON::ParserError => e
	warn "gitlab_create_mr: input is not valid JSON: #{e.message}"
	exit 2
end

%w[project source_branch target_branch title].each do |field|
	value = args[field]
	next if value.is_a?(String) && !value.empty?
	warn "gitlab_create_mr: missing required non-empty string \"#{field}\" in JSON input"
	exit 2
end

body = {
	'source_branch' => args['source_branch'],
	'target_branch' => args['target_branch'],
	'title' => args['title']
}
body['description'] = args['description'] if args['description']
body['assignee_ids'] = args['assignee_ids'] if args['assignee_ids']
body['remove_source_branch'] = args['remove_source_branch'] if args.key?('remove_source_branch')

# ==============================================================================
# REQUEST
# ==============================================================================
begin
	token = get_gitlab_token()
rescue StandardError => e
	warn "gitlab_create_mr: #{e.message}"
	exit 1
end

endpoint = "projects/#{gitlab_project(args['project'])}/merge_requests"
begin
	response = gitlab_request('POST', endpoint, token, body)
rescue StandardError => e
	warn "gitlab_create_mr: request failed: #{e.message}"
	exit 1
end

unless response.is_a?(Net::HTTPSuccess)
	warn "gitlab_create_mr: GitLab returned HTTP #{response.code}: #{response.body}"
	exit 1
end

# ==============================================================================
# RESULTS
# ==============================================================================
mr = JSON.parse(response.body)
lines = []
lines.append("Created MR !#{mr['iid']}: #{mr['title']}")
lines.append("State: #{mr['state']}")
lines.append("URL: #{mr['web_url']}")
puts lines.join("\n")

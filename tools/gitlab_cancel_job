#!/usr/bin/env ruby
# Tool contract: JSON args on stdin, result text on stdout, reason on stderr.
# "--schema" prints the tool's self-description so the registry can discover it.
# Exit codes:
#   0 = success
#   1 = runtime failure
#   2 = malformed call (bad arguments)

require 'json'
require_relative 'gitlab'

# ==============================================================================
# SCHEMA
# ==============================================================================
if ARGV[0] == '--schema'
	schema = {
		'description' => 'Cancel a running GitLab CI job. Input: {"project": "<id or path>", "job_id": <id>}. project may be a numeric id (505) or a path (riscv/riscv_cluster).',
		'input_schema' => {
			'type' => 'object',
			'properties' => {
				'project' => { 'type' => 'string', 'description' => 'Project numeric id (e.g. "505") or path (e.g. "riscv/riscv_cluster")' },
				'job_id' => { 'type' => 'integer', 'description' => 'CI job id (the numeric job id from the job URL)' }
			},
			'required' => ['project', 'job_id']
		},
		'timeout_secs' => 30
	}
	puts JSON.pretty_generate(schema)
	exit 0
end

# ==============================================================================
# PARSE
# ==============================================================================
input_json = $stdin.read
begin
	args = JSON.parse(input_json)
rescue JSON::ParserError => e
	warn "gitlab_cancel_job: input is not valid JSON: #{e.message}"
	exit 2
end

project = args['project']
if !project.is_a?(String) || project.empty?
	warn 'gitlab_cancel_job: missing required non-empty string "project" in JSON input'
	exit 2
end

job_id = args['job_id']
unless job_id.is_a?(Integer)
	warn 'gitlab_cancel_job: missing required integer "job_id" in JSON input'
	exit 2
end

# ==============================================================================
# REQUEST
# ==============================================================================
begin
	token = get_gitlab_token()
rescue StandardError => e
	warn "gitlab_cancel_job: #{e.message}"
	exit 1
end

endpoint = "projects/#{gitlab_project(project)}/jobs/#{job_id}/cancel"
begin
	response = gitlab_request('POST', endpoint, token, {})
rescue StandardError => e
	warn "gitlab_cancel_job: request failed: #{e.message}"
	exit 1
end

unless response.is_a?(Net::HTTPSuccess)
	warn "gitlab_cancel_job: GitLab returned HTTP #{response.code} for job #{job_id}: #{response.body}"
	exit 1
end

# ==============================================================================
# RESULTS
# ==============================================================================
job = JSON.parse(response.body)
puts "Canceled job ##{job['id']} '#{job['name']}' (status: #{job['status']})"

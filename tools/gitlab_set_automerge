#!/usr/bin/env ruby
# Tool contract: JSON args on stdin, result text on stdout, reason on stderr.
# "--schema" prints the tool's self-description so the registry can discover it.
# Exit codes:
#   0 = success
#   1 = runtime failure
#   2 = malformed call (bad arguments)

require 'json'
require_relative 'gitlab'

# ==============================================================================
# SCHEMA
# ==============================================================================
if ARGV[0] == '--schema'
	schema = {
		'description' => 'Set a GitLab merge request to auto-merge when its pipeline succeeds (the "merge when pipeline succeeds" button). Input: {"project": "<id or path>", "iid": <mr iid>}. Uses the /merge endpoint with merge_when_pipeline_succeeds=true. If the pipeline already passed, GitLab returns 405; this tool reports that the MR likely already merged and to use gitlab_merge_mr to merge directly.',
		'input_schema' => {
			'type' => 'object',
			'properties' => {
				'project' => { 'type' => 'string', 'description' => 'Project numeric id (e.g. "505") or path (e.g. "riscv/riscv_cluster")' },
				'iid' => { 'type' => 'integer', 'description' => 'Merge request iid (the !NNN number)' }
			},
			'required' => ['project', 'iid']
		},
		'timeout_secs' => 30
	}
	puts JSON.pretty_generate(schema)
	exit 0
end

# ==============================================================================
# PARSE
# ==============================================================================
input_json = $stdin.read
begin
	args = JSON.parse(input_json)
rescue JSON::ParserError => e
	warn "gitlab_set_automerge: input is not valid JSON: #{e.message}"
	exit 2
end

project = args['project']
if !project.is_a?(String) || project.empty?
	warn 'gitlab_set_automerge: missing required non-empty string "project" in JSON input'
	exit 2
end

iid = args['iid']
unless iid.is_a?(Integer)
	warn 'gitlab_set_automerge: missing required integer "iid" in JSON input'
	exit 2
end

# ==============================================================================
# REQUEST
# ==============================================================================
begin
	token = get_gitlab_token()
rescue StandardError => e
	warn "gitlab_set_automerge: #{e.message}"
	exit 1
end

endpoint = "projects/#{gitlab_project(project)}/merge_requests/#{iid}/merge"
begin
	response = gitlab_request('PUT', endpoint, token, { 'merge_when_pipeline_succeeds' => true })
rescue StandardError => e
	warn "gitlab_set_automerge: request failed: #{e.message}"
	exit 1
end

# 405 means the pipeline already passed, so auto-merge can't be armed; the MR
# has usually already merged. Point the caller at gitlab_merge_mr to finish it.
if response.code.to_i == 405
	warn "gitlab_set_automerge: HTTP 405 for !#{iid} — pipeline likely already passed. Check the MR state; if still open, merge directly with gitlab_merge_mr."
	exit 1
end

unless response.is_a?(Net::HTTPSuccess)
	warn "gitlab_set_automerge: GitLab returned HTTP #{response.code} for !#{iid}: #{response.body}"
	exit 1
end

# ==============================================================================
# RESULTS
# ==============================================================================
mr = JSON.parse(response.body)
puts "MR !#{mr['iid']} set to auto-merge when the pipeline succeeds (state: #{mr['state']}): #{mr['web_url']}"

#!/usr/bin/env ruby
# Tool contract: JSON args on stdin, result text on stdout, reason on stderr.
# "--schema" prints the tool's self-description so the registry can discover it.
# Exit codes:
#   0 = success
#   1 = runtime failure
#   2 = malformed call (bad arguments)

# ==============================================================================
# SCHEMA
# ==============================================================================
require 'json'
require 'net/http'
require 'time'
require 'uri'

if ARGV[0] == '--schema'
	schema = {
		'description' => 'Read a Slack thread: the parent message plus all its replies. Input: {"channel_id": "<id>", "message_ts": "<parent ts, e.g. 1234567890.123456>", "limit": <1-1000>, "cursor": "<cursor>"}.',
		'input_schema' => {
			'type' => 'object',
			'properties' => {
				'channel_id' => { 'type' => 'string', 'description' => 'Channel, private group, IM, or group DM ID the thread lives in' },
				'message_ts' => { 'type' => 'string', 'description' => 'Timestamp of the parent message, Slack ts format with a decimal point (e.g. "1234567890.123456")' },
				'limit' => { 'type' => 'integer', 'description' => 'Number of messages to return, 1-1000 (default 100)' },
				'cursor' => { 'type' => 'string', 'description' => 'Pagination cursor from a previous response next_cursor' }
			},
			'required' => ['channel_id', 'message_ts']
		},
		'timeout_secs' => 30
	}
	puts JSON.pretty_generate(schema)
	exit 0
end

# ==============================================================================
# TOKEN
# ==============================================================================
# Read the Slack OAuth token from mcp_auth.json, resolved under
# `$XDG_CONFIG_HOME/llm-agent` (with the standard `$HOME/.config` default).
def get_slack_token
	xdg = ENV.fetch('XDG_CONFIG_HOME', File.join(Dir.home, '.config'))
	auth_file = File.join(xdg, 'llm-agent', 'mcp_auth.json')
	data = JSON.parse(File.read(auth_file))
	key = data.keys.find { |candidate| candidate.start_with?('slack|') }
	raise "no Slack token found in #{auth_file}" unless key
	return data[key]['accessToken']
end

# ==============================================================================
# HELPERS
# ==============================================================================
def slack_get(endpoint, params, token)
	uri = URI("https://slack.com/api/#{endpoint}")
	uri.query = URI.encode_www_form(params)
	http = Net::HTTP.new(uri.host, uri.port)
	http.use_ssl = true
	request = Net::HTTP::Get.new(uri, 'Authorization' => "Bearer #{token}")
	return JSON.parse(http.request(request).body)
end

# Local-machine time matches the MCP tool's rendering when the host tz is the
# reader's tz. Format e.g. "2026-07-28 11:17:29 CDT".
def format_ts(timestamp)
	return Time.at(timestamp.to_f).strftime('%Y-%m-%d %H:%M:%S %Z')
end

# Resolve a user_id to [real_name, email], caching each lookup in the passed hash.
def resolve_user(user_id, token, cache)
	return cache[user_id] if cache.key?(user_id)
	info = slack_get('users.info', { 'user' => user_id }, token)
	member = info['user'] || {}
	profile = member['profile'] || {}
	real_name = profile['real_name'].to_s
	real_name = member['real_name'].to_s if real_name.empty?
	real_name = user_id if real_name.empty?
	email = profile['email'].to_s
	cache[user_id] = [real_name, email]
	return cache[user_id]
end

# Build the "From:" identity string for one message.
def sender_identity(message, token, cache)
	bot_profile = message['bot_profile']
	return "#{bot_profile['name']} [bot]" if bot_profile

	user_id = message['user'].to_s
	if user_id.empty?
		username = message['username'].to_s
		return username.empty? ? 'unknown' : username
	end

	real_name, email = resolve_user(user_id, token, cache)
	return email.empty? ? "#{real_name} (#{user_id})" : "#{real_name} <#{email}> (#{user_id})"
end

# Append the From/Time/TS/body/reactions block for one message to lines.
def append_message(lines, message, token, cache)
	lines.append("From: #{sender_identity(message, token, cache)}")
	lines.append("Time: #{format_ts(message['ts'])}")
	lines.append("Message TS: #{message['ts']}")
	lines.append(message['text'].to_s)

	reactions = message['reactions'] || []
	return if reactions.empty?
	reaction_parts = []
	reactions.each do |reaction|
		reaction_parts.append("#{reaction['name']} (#{reaction['count']})")
	end
	lines.append("Reactions: #{reaction_parts.join('  ')}")
end

# ==============================================================================
# PARSE
# ==============================================================================
input_json = $stdin.read
begin
	args = JSON.parse(input_json)
rescue JSON::ParserError => e
	warn "slack_read_thread: input is not valid JSON: #{e.message}"
	exit 2
end

channel_id = args['channel_id']
if !channel_id.is_a?(String) || channel_id.empty?
	warn 'slack_read_thread: missing required non-empty string "channel_id" in JSON input; expected {"channel_id": "<id>", "message_ts": "<ts>"}'
	exit 2
end

message_ts = args['message_ts']
if !message_ts.is_a?(String) || message_ts.empty?
	warn 'slack_read_thread: missing required non-empty string "message_ts" in JSON input; expected {"channel_id": "<id>", "message_ts": "<ts>"}'
	exit 2
end

# ==============================================================================
# REQUEST
# ==============================================================================
begin
	token = get_slack_token
rescue StandardError => e
	warn "slack_read_thread: #{e.message}"
	exit 1
end

replies_params = { 'channel' => channel_id, 'ts' => message_ts }
replies_params['limit'] = args['limit'] if args['limit']
replies_params['cursor'] = args['cursor'] if args['cursor']

begin
	result = slack_get('conversations.replies', replies_params, token)
rescue StandardError => e
	warn "slack_read_thread: request failed: #{e.message}"
	exit 1
end

unless result['ok']
	warn "slack_read_thread: Slack error: #{result['error']}"
	exit 1
end

# ==============================================================================
# FORMAT
# ==============================================================================
# conversations.replies returns the parent first, then replies in chronological
# order. Split them to match the MCP tool's parent/replies layout.
messages = result['messages'] || []
if messages.empty?
	warn "slack_read_thread: no messages returned for #{channel_id} ts #{message_ts}"
	exit 1
end

parent = messages.first
replies = messages.drop(1)
user_cache = {}

lines = []
lines.append('=== THREAD PARENT MESSAGE ===')
append_message(lines, parent, token, user_cache)
lines.append('')

lines.append("=== THREAD REPLIES (#{replies.length} total) ===")
lines.append('')

replies.each_with_index do |reply, index|
	lines.append("--- Reply #{index + 1} of #{replies.length} ---")
	append_message(lines, reply, token, user_cache)
	lines.append('')
end

next_cursor = result.dig('response_metadata', 'next_cursor').to_s
lines.append("next_cursor: #{next_cursor}") unless next_cursor.empty?

puts lines.join("\n")

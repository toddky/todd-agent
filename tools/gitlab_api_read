#!/usr/bin/env ruby
# Tool contract: JSON args on stdin, result text on stdout, reason on stderr.
# "--schema" prints the tool's self-description so the registry can discover it.
# Exit codes:
#   0 = success
#   1 = runtime failure
#   2 = malformed call (bad arguments)

require 'json'
require_relative 'gitlab'

# ==============================================================================
# SCHEMA
# ==============================================================================
if ARGV[0] == '--schema'
	schema = {
		'description' => 'Raw read-only GitLab REST v4 GET passthrough. The endpoint is relative to /api/v4/. Input: {"endpoint": "<endpoint>"}, e.g. {"endpoint": "projects/505/merge_requests?state=opened&per_page=5"}. A project can be a numeric id (505) or URL-encoded path (riscv%2Friscv_cluster). Returns the raw response body (pretty-printed when JSON). GET only; writes and deletes are not possible through this tool.',
		'input_schema' => {
			'type' => 'object',
			'properties' => {
				'endpoint' => { 'type' => 'string', 'description' => 'REST v4 endpoint relative to /api/v4/, e.g. "projects/505/merge_requests/123" or "user"' }
			},
			'required' => ['endpoint']
		},
		'timeout_secs' => 30
	}
	puts JSON.pretty_generate(schema)
	exit 0
end

# ==============================================================================
# PARSE
# ==============================================================================
input_json = $stdin.read
begin
	args = JSON.parse(input_json)
rescue JSON::ParserError => e
	warn "gitlab_api_read: input is not valid JSON: #{e.message}"
	exit 2
end

endpoint = args['endpoint']
if !endpoint.is_a?(String) || endpoint.empty?
	warn 'gitlab_api_read: missing required non-empty string "endpoint" in JSON input; expected {"endpoint": "projects/505/merge_requests"}'
	exit 2
end

# ==============================================================================
# REQUEST
# ==============================================================================
begin
	token = get_gitlab_token()
rescue StandardError => e
	warn "gitlab_api_read: #{e.message}"
	exit 1
end

begin
	response = gitlab_request('GET', endpoint, token)
rescue StandardError => e
	warn "gitlab_api_read: request failed: #{e.message}"
	exit 1
end

unless response.is_a?(Net::HTTPSuccess)
	warn "gitlab_api_read: GitLab returned HTTP #{response.code} for #{endpoint}: #{response.body}"
	exit 1
end

# ==============================================================================
# RESULTS
# ==============================================================================
# Pretty-print when the body parses as JSON; otherwise pass it through as-is.
body = response.body.to_s
begin
	puts JSON.pretty_generate(JSON.parse(body))
rescue JSON::ParserError
	puts body
end

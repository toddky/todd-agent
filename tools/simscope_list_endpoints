#!/usr/bin/env ruby
# Tool contract: JSON args on stdin, result text on stdout, reason on stderr.
# "--schema" prints the tool's self-description so the registry can discover it.
# Exit codes:
#   0 = success
#   1 = runtime failure
#   2 = malformed call (bad arguments)

require 'json'
require_relative 'simscope'

# ==============================================================================
# SCHEMA
# ==============================================================================
if ARGV[0] == '--schema'
	schema = {
		'description' => 'List the top-level Simscope REST API endpoints as a name->path map. Simscope is a test triage and regression management system. Takes no input. Useful for discovering which endpoint families exist (Runs, Tests, Users, Coverage, etc.).',
		'input_schema' => {
			'type' => 'object',
			'properties' => {}
		},
		'timeout_secs' => 30
	}
	puts JSON.pretty_generate(schema)
	exit 0
end

# ==============================================================================
# REQUEST
# ==============================================================================
begin
	token = get_simscope_token()
rescue StandardError => e
	warn "simscope_list_endpoints: #{e.message}"
	exit 1
end

begin
	response = simscope_get('', token)
	endpoints = simscope_parse(response)
rescue StandardError => e
	warn "simscope_list_endpoints: request failed: #{e.message}"
	exit 1
end

unless response.is_a?(Net::HTTPSuccess)
	warn "simscope_list_endpoints: Simscope returned HTTP #{response.code}: #{response.body}"
	exit 1
end

# ==============================================================================
# RESULTS
# ==============================================================================
endpoints = {} unless endpoints.is_a?(Hash)

lines = []
lines.append("#{endpoints.length} endpoint(s)")
lines.append('')
endpoints.sort.each do |name, path|
	lines.append("#{name}: #{path}")
end

puts lines.join("\n")

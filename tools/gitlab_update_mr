#!/usr/bin/env ruby
# Tool contract: JSON args on stdin, result text on stdout, reason on stderr.
# "--schema" prints the tool's self-description so the registry can discover it.
# Exit codes:
#   0 = success
#   1 = runtime failure
#   2 = malformed call (bad arguments)

require 'json'
require_relative 'gitlab'

# ==============================================================================
# SCHEMA
# ==============================================================================
if ARGV[0] == '--schema'
	schema = {
		'description' => 'Edit a GitLab merge request. Input: {"project": "<id or path>", "iid": <mr iid>, "title": "<t>", "description": "<d>", "add_labels": "<a,b>", "remove_labels": "<a,b>", "assignee_ids": [<ids>], "reviewer_ids": [<ids>]}. project + iid required; every other field is optional but at least one must be given. NOTE: assignee_ids and reviewer_ids are FULL REPLACEMENTS, not additive; fetch the current list first if adding. To close/reopen an MR use gitlab_close_mr.',
		'input_schema' => {
			'type' => 'object',
			'properties' => {
				'project' => { 'type' => 'string', 'description' => 'Project numeric id (e.g. "505") or path (e.g. "riscv/riscv_cluster")' },
				'iid' => { 'type' => 'integer', 'description' => 'Merge request iid (the !NNN number)' },
				'title' => { 'type' => 'string', 'description' => 'New title (optional)' },
				'description' => { 'type' => 'string', 'description' => 'New description body (optional)' },
				'add_labels' => { 'type' => 'string', 'description' => 'Comma-separated labels to add, e.g. "merge-into-main" (optional)' },
				'remove_labels' => { 'type' => 'string', 'description' => 'Comma-separated labels to remove (optional)' },
				'assignee_ids' => { 'type' => 'array', 'items' => { 'type' => 'integer' }, 'description' => 'FULL replacement of assignees (optional)' },
				'reviewer_ids' => { 'type' => 'array', 'items' => { 'type' => 'integer' }, 'description' => 'FULL replacement of reviewers (optional)' }
			},
			'required' => ['project', 'iid']
		},
		'timeout_secs' => 30
	}
	puts JSON.pretty_generate(schema)
	exit 0
end

# ==============================================================================
# PARSE
# ==============================================================================
input_json = $stdin.read
begin
	args = JSON.parse(input_json)
rescue JSON::ParserError => e
	warn "gitlab_update_mr: input is not valid JSON: #{e.message}"
	exit 2
end

project = args['project']
if !project.is_a?(String) || project.empty?
	warn 'gitlab_update_mr: missing required non-empty string "project" in JSON input'
	exit 2
end

iid = args['iid']
unless iid.is_a?(Integer)
	warn 'gitlab_update_mr: missing required integer "iid" in JSON input'
	exit 2
end

# Collect only the editable fields the caller provided.
body = {}
%w[title description add_labels remove_labels assignee_ids reviewer_ids].each do |field|
	body[field] = args[field] if args.key?(field)
end
if body.empty?
	warn 'gitlab_update_mr: provide at least one field to change (title, description, add_labels, remove_labels, assignee_ids, reviewer_ids)'
	exit 2
end

# ==============================================================================
# REQUEST
# ==============================================================================
begin
	token = get_gitlab_token()
rescue StandardError => e
	warn "gitlab_update_mr: #{e.message}"
	exit 1
end

endpoint = "projects/#{gitlab_project(project)}/merge_requests/#{iid}"
begin
	response = gitlab_request('PUT', endpoint, token, body)
rescue StandardError => e
	warn "gitlab_update_mr: request failed: #{e.message}"
	exit 1
end

unless response.is_a?(Net::HTTPSuccess)
	warn "gitlab_update_mr: GitLab returned HTTP #{response.code} for !#{iid}: #{response.body}"
	exit 1
end

# ==============================================================================
# RESULTS
# ==============================================================================
mr = JSON.parse(response.body)
lines = []
lines.append("Updated MR !#{mr['iid']}: #{mr['title']}")
lines.append("State: #{mr['state']}")
lines.append("Labels: #{(mr['labels'] || []).join(', ')}")
lines.append("URL: #{mr['web_url']}")
puts lines.join("\n")
